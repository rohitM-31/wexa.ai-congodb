# Copy this file to .env and fill in real values. Never commit .env.
# All secrets are read from environment variables at runtime — none are
# ever written to results/ or committed to the repo.

# --- CognoDB Cloud (Bolt / Cypher, free c0 instance) ---
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=


